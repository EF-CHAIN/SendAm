# Copy to a root-level .env on the production host and store it with mode 0600.
# Prefer injecting these values from the platform secret store.
POSTGRES_USER=sendam
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=sendam
POSTGRES_LOG_MIN_DURATION_MS=1000
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
