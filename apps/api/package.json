{
  "name": "sendam-api",
  "version": "1.0.0",
  "description": "SendAm Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon src/worker.js",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "node ../../scripts/run-migrations.js",
    "db:validate": "node scripts/validate-production-db.js",
    "db:provision": "npm run prisma:deploy && node scripts/validate-production-db.js",
    "whatsapp:webhook:configure": "node scripts/configure-whatsapp-webhook.js",
    "test": "node --test",
    "deploy:contracts:testnet": "node ../../scripts/deploy-soroban.js --network testnet",
    "deploy:contracts:mainnet": "node ../../scripts/deploy-soroban.js --network mainnet",
    "db:verify-restore": "node scripts/verify-restore-drill.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@jest/globals": "^29.7.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.10.0",
    "@prisma/instrumentation": "^7.10.1",
    "@signpdf/placeholder-pdfkit": "^3.4.0",
    "@signpdf/signer-p12": "^3.4.0",
    "@signpdf/signpdf": "^3.4.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "axios": "^1.6.8",
    "bip39": "^3.1.2",
    "bullmq": "^5.79.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ed25519-hd-key": "^1.3.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.11.4",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "effect": "^3.20.0",
    "eslint": "^9.28.0",
    "globals": "^16.0.0",
    "nodemon": "^3.1.0",
    "prisma": "^7.8.0"
  }
}
