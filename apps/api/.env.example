PORT=3002
NODE_ENV=development
# Production requires TLS for remote hosts. Keep this value in a secret store.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/sendam?sslmode=require
# Comma-separated origins allowed to call the REST API (admin + landing apps).
# Required in production; when empty in dev, all origins are allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# 64-char hex (32 bytes). Generate your own — never reuse this placeholder.
# Used for aes-256-gcm encryption of wallet secret keys.
# openssl rand -hex 32
ENCRYPTION_KEY=
# One-release legacy bootstrap. The first successful login provisions this
# individual administrator; remove both values after verifying the account.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Retained for existing cryptographic uses; admin sessions are database-backed.
JWT_SECRET=
# Optional: admin session lifetime in hours (default 12).
ADMIN_SESSION_TTL_HOURS=12
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token
# Meta App Secret — verifies the X-Hub-Signature-256 header on webhook POSTs.
# Required in production; without it, forged webhook events are rejected.
WHATSAPP_APP_SECRET=
# Public callback registered on the WhatsApp Business Account. It must end in
# /webhook and use HTTPS in production.
WHATSAPP_CALLBACK_URL=https://api.example.com/webhook
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Set to a currently supported Meta Graph version, for example vXX.X.
META_GRAPH_API_VERSION=
# Per-user transfer guardrails (XLM). Defaults: 1000 / 5000 / 50.
MAX_SEND_AMOUNT=1000
DAILY_SEND_LIMIT=5000
MAX_SENDS_PER_DAY=50
# Request rate limits (PostgreSQL-backed, shared across instances).
# REST API: max requests per IP per window. WhatsApp bot: max messages per
# sender per window.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
BOT_RATE_WINDOW_SEC=60
BOT_RATE_MAX=20
REDIS_URL=
UPSTASH_REDIS_URL=
# Background worker (src/worker.js) BullMQ tuning.
WORKER_CONCURRENCY=5
WORKER_LOCK_DURATION_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
# Per-customer WhatsApp message ordering (issue #157).
WHATSAPP_ORDER_REQUEUE_DELAY_MS=250
WHATSAPP_ORDER_MAX_REQUEUES=40
# Structured telemetry and production alert routing.
SERVICE_NAME=sendam-api
RELEASE_SHA=
# Dedicated bearer token for GET /metrics (minimum 32 characters).
METRICS_TOKEN=
# HTTPS incident/error ingestion endpoint (PagerDuty relay, Sentry-compatible
# relay, or internal alert router). ERROR_MONITOR_TOKEN is optional bearer auth.
ERROR_MONITOR_WEBHOOK_URL=
ERROR_MONITOR_TOKEN=
ERROR_MONITOR_TIMEOUT_MS=3000
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Issuer address for USDC on Stellar. Defaults to the SDF test-anchor issuer on testnet.
# Mainnet deployments must set this to Circle's mainnet USDC issuer address: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_AUTH_SIGNING_KEY=
STELLAR_HOME_DOMAIN=sendam.app
STELLAR_WEB_AUTH_DOMAIN=api.sendam.app
STELLAR_AUTH_CHALLENGE_TTL_SECONDS=300
REST_SESSION_TTL_MINUTES=15
# Operational kill switch for the SEP-10-authenticated REST wallet API.
ENABLE_WALLET_REST_API=false
# Pricing and FX.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_TIMEOUT_MS=10000
EXCHANGERATE_API_KEY=
PRICING_PROVIDER_TIMEOUT_MS=3000
PRICING_PROVIDER_MAX_RETRIES=2
PRICING_PROVIDER_CIRCUIT_THRESHOLD=3
PRICING_PROVIDER_CIRCUIT_COOLDOWN_MS=30000
# Fresh cached rates may be reused immediately; stale cached rates are used only after provider failure.
PRICING_RATE_CACHE_MAX_AGE_MS=60000
PRICING_STALE_RATE_CACHE_MAX_AGE_MS=300000
PRICING_PROVIDER_MAX_SOURCE_AGE_MS=86400000
PRICING_PROVIDER_MAX_RATE=1000000000
PRICING_SPREAD_BASIS_POINTS=0
PRICING_FEE_POLICY_VERSION=standard-v1

# KYC, AML, and PIN verification.
KYC_PROVIDER=smileid
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
# Public HTTPS endpoint registered with Smile ID.
SMILE_ID_CALLBACK_URL=https://api.example.com/api/compliance/kyc/callback/smileid
# Sandbox is selected outside production and production in NODE_ENV=production.
# Override only for a controlled proxy or provider-approved endpoint.
SMILE_ID_BASE_URL=
SMILE_ID_TIMEOUT_MS=10000
# Reject signed callbacks whose provider timestamp is older than this.
SMILE_ID_CALLBACK_TOLERANCE_SEC=300
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
PIN_PEPPER=
# Compliance policy amounts are in POLICY_CURRENCY (NGN), not the settlement asset.
POLICY_CURRENCY=NGN
POLICY_VERSION=1
POLICY_FX_MAX_AGE_MS=300000
TIER_1_DAILY_LIMIT=50000.00
TIER_1_SINGLE_LIMIT=20000.00
TIER_2_DAILY_LIMIT=500000.00
TIER_2_SINGLE_LIMIT=200000.00
TIER_3_DAILY_LIMIT=5000000.00
TIER_3_SINGLE_LIMIT=1000000.00

# Voice payments.
VOICE_PROVIDER=deepgram
DEEPGRAM_API_KEY=
WHISPER_API_KEY=
OPENAI_API_KEY=

# Cloudflare R2 for media/receipt storage.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Outbound message transport.
# meta = send messages through the WhatsApp Cloud API.
# sim = write outgoing messages to the chat simulator.
MESSAGE_TRANSPORT=meta

# Enable the local chat simulator endpoints.
# Set to true to test the assistant without WhatsApp.
ENABLE_CHAT_SIM=false
