route:
  receiver: sendam-operations
  group_by: [alertname, service, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity="critical"
      receiver: sendam-on-call
      repeat_interval: 30m

receivers:
  - name: sendam-operations
    webhook_configs:
      - url: https://alerts.example.com/sendam/operations
        send_resolved: true
  - name: sendam-on-call
    webhook_configs:
      - url: https://alerts.example.com/sendam/on-call
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - alertname="SendAmApiDown"
    target_matchers:
      - service="sendam-api"
    equal: [service]
