{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (status_code) (rate(sendam_http_requests_total[5m]))", "legendFormat": "{{status_code}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sendam_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Exceptions by source",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (source) (rate(sendam_exceptions_total[5m]))", "legendFormat": "{{source}}" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Queue outcomes",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (queue, status) (rate(sendam_queue_jobs_total[5m]))", "legendFormat": "{{queue}} {{status}}" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
    },
    {
      "id": 5,
      "title": "Webhook outcomes",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (status) (rate(sendam_webhook_events_total[5m]))", "legendFormat": "{{status}}" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }
    },
    {
      "id": 6,
      "title": "Queue depth (waiting jobs)",
      "type": "timeseries",
      "targets": [
        { "expr": "max by (queue) (bullmq_waiting_jobs_count)", "legendFormat": "{{queue}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 7,
      "title": "Active jobs",
      "type": "timeseries",
      "targets": [
        { "expr": "max by (queue) (bullmq_active_jobs_count)", "legendFormat": "{{queue}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "id": 8,
      "title": "Job duration p95",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(bullmq_job_duration_seconds_bucket[5m])))", "legendFormat": "{{queue}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
    },
    {
      "id": 9,
      "title": "Job wait time p95 (worker starvation)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(bullmq_job_wait_seconds_bucket[5m])))", "legendFormat": "{{queue}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }
    },
    {
      "id": 10,
      "title": "Redis memory used",
      "type": "timeseries",
      "targets": [
        { "expr": "max(bullmq_redis_memory_used_bytes)", "legendFormat": "used_memory" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }
    }
  ],
  "schemaVersion": 39,
  "tags": ["sendam", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "SendAm Production",
  "uid": "sendam-production",
  "version": 1
}
